# Copy to .env.local for local development. Everything here is optional.

# Where the API lives. Leave this COMMENTED OUT unless you're hosting the
# frontend separately from the API:
#   * `npm run dev` already talks to http://localhost:8000
#   * a production build with no value set talks to the origin that served
#     it, which is what the single-container deployment relies on
# Set it only when the frontend is served from a different origin than the API:
# VITE_API_BASE_URL=https://api.your-domain.com

# Optional: enables the "Continue with Google" / "Continue with Microsoft"
# buttons. Leave blank to hide a button whose provider isn't configured
# (matches the backend, which independently requires the same client ids
# under GOOGLE_CLIENT_ID / MICROSOFT_CLIENT_ID to verify the tokens).
VITE_GOOGLE_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=
