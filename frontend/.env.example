# Copy to .env.local for local development.

VITE_API_BASE_URL=http://localhost:8000

# Optional: enables the "Continue with Google" / "Continue with Microsoft"
# buttons. Leave blank to hide a button whose provider isn't configured
# (matches the backend, which independently requires the same client ids
# under GOOGLE_CLIENT_ID / MICROSOFT_CLIENT_ID to verify the tokens).
VITE_GOOGLE_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=
