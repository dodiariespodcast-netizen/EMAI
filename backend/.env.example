# Copy to .env and fill in for local development.

ENVIRONMENT=development

# SQLite by default (zero setup). For anything beyond a single dev machine,
# point this at Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg2://emai:emai@localhost:5432/emai_scheduler
DATABASE_URL=sqlite:///./emai_scheduler.db

# Generate a real secret for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Optional. Natural-language request parsing and AI schedule summaries
# degrade to deterministic fallbacks when this is unset.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

SOLVER_TIME_LIMIT_SECONDS=30
