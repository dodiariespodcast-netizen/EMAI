# Copy to .env before `docker compose up`. Only SECRET_KEY is required.

# ---- required ----
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ---- where the app is reachable from a browser ----
# One origin serves both the app and the API. Change this when you put it
# behind a real domain.
PUBLIC_BASE_URL=http://localhost:8000
APP_PORT=8000

# Cross-origin browser access. Empty is correct for the single-container
# setup (the app is same-origin). Only needed if you host the frontend
# separately, e.g. ["https://app.your-domain.com"].
CORS_ORIGINS=[]

ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- database (compose provides one; override to use a managed Postgres) ----
POSTGRES_USER=emai
POSTGRES_PASSWORD=emai
POSTGRES_DB=emai_scheduler

# ---- optional: AI layer ----
# Without this, natural-language request parsing and schedule summaries fall
# back to deterministic versions. Everything else works the same.
ANTHROPIC_API_KEY=

# ---- optional: "Sign in with Google / Microsoft" ----
# Each button only appears when its client id is set (it's used both to build
# the frontend and to verify tokens in the API).
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=

# ---- optional: outbound email ----
# Without SMTP, invites and password resets are logged instead of sent, and
# the invite link is shown in the UI so you can pass it along by hand.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@example.com
