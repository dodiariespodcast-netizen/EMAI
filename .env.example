# Copy to .env before `docker compose up`. Only SECRET_KEY is required.

# ---- required ----
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ---- ports (change if these clash with something else you run) ----
API_PORT=8000
WEB_PORT=5173

# ---- where things are reachable from a browser ----
# Update both when you deploy to a real domain, and add the web origin to
# CORS_ORIGINS.
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]

ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- database (compose provides one; override to use a managed Postgres) ----
POSTGRES_USER=emai
POSTGRES_PASSWORD=emai
POSTGRES_DB=emai_scheduler

# ---- optional: AI layer ----
# Without this, natural-language request parsing and schedule summaries fall
# back to deterministic versions. Everything else works the same.
ANTHROPIC_API_KEY=

# ---- optional: "Sign in with Google / Microsoft" ----
# Each button only appears when its client id is set on BOTH sides (the
# frontend build arg and the API, which verifies the token).
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=

# ---- optional: outbound email ----
# Without SMTP, invites and password resets are logged instead of sent, and
# the invite link is shown in the UI so you can pass it along by hand.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@example.com
